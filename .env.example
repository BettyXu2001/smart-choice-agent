# Required: generate once with python -c "import secrets; print(secrets.token_hex(32))"
# This file is not loaded automatically; export variables or pass --env-file to Docker.
CHOICE_AGENT_SESSION_SECRET=
# Set false only for local HTTP; public HTTPS must keep true.
CHOICE_AGENT_COOKIE_SECURE=true
CHOICE_AGENT_DATABASE_URL=sqlite:///./choice_agent.db
CHOICE_AGENT_MODEL_API_KEY=
CHOICE_AGENT_MODEL_BASE_URL=https://api.deepseek.com
# Additional trusted browser endpoints: exact HTTPS Base URLs, JSON string arrays.
CHOICE_AGENT_MODEL_BASE_URL_ALLOWLIST=[]
CHOICE_AGENT_MODEL_PROVIDER_NAME=openai-compatible
CHOICE_AGENT_MODEL_PRICING_JSON={}
CHOICE_AGENT_MAIN_MODEL=deepseek-v4-pro
CHOICE_AGENT_LIGHT_MODEL=deepseek-v4-flash
CHOICE_AGENT_MODEL_TIMEOUT_SECONDS=30
CHOICE_AGENT_ENABLE_LLM=false
CHOICE_AGENT_DEBUG=true
CHOICE_AGENT_SEARCH_PROVIDER=fixture
CHOICE_AGENT_SEARCH_API_KEY=
CHOICE_AGENT_SEARCH_BASE_URL=https://api.openai.com/v1
CHOICE_AGENT_SEARCH_BASE_URL_ALLOWLIST=[]
CHOICE_AGENT_SEARCH_MODEL=gpt-5-mini
CHOICE_AGENT_SEARCH_TIMEOUT_SECONDS=20
CHOICE_AGENT_SEARCH_MAX_QUERIES=2
